  </Grid>

  <Grid x:Name="CountryLayer" Visibility="Collapsed" Background="#01000000">
<Border x:Name="PopupBox" CornerRadius="18" Background="#F5202028" BorderBrush="#2EFFFFFF" BorderThickness="1" Padding="8" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.5,0">
      <Border.RenderTransform><ScaleTransform x:Name="PopupScale"/></Border.RenderTransform>
              <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.5"/></Border.Effect>
              <StackPanel>
                <Grid>
                  <TextBox x:Name="TxtSearch" Style="{StaticResource Input}" Padding="17,4,5,4"/>
                  <Viewbox Width="14" Height="14" HorizontalAlignment="Left" Margin="13,0,0,0" IsHitTestVisible="False">
                    <Canvas Width="24" Height="24">
                      <Path Style="{StaticResource Glyph}" Stroke="#99FFFFFF" StrokeThickness="2.5" Data="M10.5,3 A7.5,7.5 0 1 0 10.51,3 Z M16,16 L21,21"/>
                    </Canvas>
                  </Viewbox>
                  <TextBlock x:Name="PhSearch" Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource Tertiary}"/>
                </Grid>
                <ListBox x:Name="CountryList" Height="300" Margin="0,8,0,0" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource CountryItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="28" Height="20" CornerRadius="4" Margin="0,0,12,0" Background="{Binding Flag}" BorderBrush="#26FFFFFF" BorderThickness="0.5"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Foreground="#F5F5F7" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{Binding Sub}" VerticalAlignment="Center" Foreground="#80FFFFFF" FontSize="11.5" Margin="8,0,0,0"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Border>
  </Grid>

  <Grid x:Name="Overlay" Visibility="Collapsed">
    <Border Background="#FF131119"/>
    <Canvas IsHitTestVisible="False" ClipToBounds="True">
      <Ellipse Width="460" Height="460" Canvas.Left="-190" Canvas.Top="-170">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#557D4698" Offset="0"/>
            <GradientStop Color="#007D4698" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse Width="420" Height="420" Canvas.Left="170" Canvas.Top="520">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#402D63E0" Offset="0"/>
            <GradientStop Color="#002D63E0" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
    </Canvas>

    <Grid x:Name="Sheet">
      <Grid.RenderTransform><TranslateTransform x:Name="SheetShift"/></Grid.RenderTransform>
      <Grid.RowDefinitions>
        <RowDefinition Height="52"/>
        <RowDefinition/>
      </Grid.RowDefinitions>

      <Grid Margin="10,0,18,0">
        <Button x:Name="BtnSheetClose" Style="{StaticResource IconBtn}" HorizontalAlignment="Left" VerticalAlignment="Center">
          <Path Data="M7,0 L0,7 L7,14" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </Button>
        <TextBlock x:Name="TxtSettingsTitle" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource Display}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
      </Grid>

      <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="18,0,14,28">
          <TextBlock x:Name="TxtSettingsBig" FontSize="32" FontWeight="Bold" FontFamily="{StaticResource Display}" Margin="4,0,0,4"/>

          <TextBlock x:Name="HdrGeneral" Style="{StaticResource Header}"/>
          <ContentControl Style="{StaticResource Card}" Padding="0,4">
            <StackPanel>
              <StackPanel Margin="16,12,16,12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                  </Grid.ColumnDefinitions>
                  <Border Style="{StaticResource Tile}" Background="#0A84FF">
                    <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24">
                      <Path Style="{StaticResource Glyph}" Data="M12,3 A9,9 0 1 0 12.01,3 Z M3,12 H21 M12,3 C8.5,7 8.5,17 12,21 M12,3 C15.5,7 15.5,17 12,21"/>
                    </Canvas></Viewbox>
                  </Border>
                  <TextBlock x:Name="HdrLang" Grid.Column="1" FontSize="13.5" VerticalAlignment="Center"/>
                </Grid>
                <Border CornerRadius="12" Background="#2A000000" BorderBrush="#14FFFFFF" BorderThickness="1" Padding="1" Margin="0,12,0,0">
                  <UniformGrid Columns="3">
                    <RadioButton x:Name="SegAuto" Style="{StaticResource Seg}" GroupName="lang"/>
                    <RadioButton x:Name="SegPt" Style="{StaticResource Seg}" GroupName="lang" Content="Português"/>
                    <RadioButton x:Name="SegEn" Style="{StaticResource Seg}" GroupName="lang" Content="English"/>
                  </UniformGrid>
                </Border>
              </StackPanel>
              <Rectangle Style="{StaticResource Sep}"/>
              <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Tile}" Background="#30B158">
                  <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24">
                    <Path Style="{StaticResource Glyph}" Data="M3,4 H10 V11 H3 Z M14,4 H21 V11 H14 Z M3,14 H10 V21 H3 Z M14,14 H21 V21 H14 Z"/>
                  </Canvas></Viewbox>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock x:Name="LblAutostart" FontSize="13.5"/>
                  <TextBlock x:Name="DescAutostart" FontSize="11.5" Foreground="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,1,10,0"/>
                </StackPanel>
                <CheckBox x:Name="ChkAutostart" Grid.Column="2" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
              </Grid>
              <Rectangle Style="{StaticResource Sep}"/>
              <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Tile}" Background="#5E5CE6">
                  <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24">
                    <Path Style="{StaticResource Glyph}" Data="M4,5 H20 A1,1 0 0 1 21,6 V15 A1,1 0 0 1 20,16 H4 A1,1 0 0 1 3,15 V6 A1,1 0 0 1 4,5 Z M8,20 H16 M12,16 V20"/>
                  </Canvas></Viewbox>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock x:Name="LblTray" FontSize="13.5"/>
                  <TextBlock x:Name="DescTray" FontSize="11.5" Foreground="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,1,10,0"/>
                </StackPanel>
                <CheckBox x:Name="ChkTray" Grid.Column="2" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
              </Grid>
            </StackPanel>
          </ContentControl>

          <TextBlock x:Name="HdrNetwork" Style="{StaticResource Header}"/>
          <ContentControl Style="{StaticResource Card}" Padding="16,14">
            <StackPanel>
              <UniformGrid x:Name="StatsGrid" Columns="3">
                <StackPanel Margin="0,4,0,10">
                  <TextBlock x:Name="StatRelays" Text="—" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource Display}"/>
                  <TextBlock x:Name="LblStatRelays" Style="{StaticResource Mini}"/>
                </StackPanel>
                <StackPanel Margin="0,4,0,10">
                  <TextBlock x:Name="StatExits" Text="—" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource Display}" Foreground="#9BF5B4"/>
                  <TextBlock x:Name="LblStatExits" Style="{StaticResource Mini}"/>
                </StackPanel>
                <StackPanel Margin="0,4,0,10">
                  <TextBlock x:Name="StatGuards" Text="—" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource Display}" Foreground="#DDBFFF"/>
                  <TextBlock x:Name="LblStatGuards" Style="{StaticResource Mini}"/>
                </StackPanel>
                <StackPanel Margin="0,4,0,0">
                  <TextBlock x:Name="StatCountries" Text="—" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource Display}"/>
                  <TextBlock x:Name="LblStatCountries" Style="{StaticResource Mini}"/>
                </StackPanel>
                <StackPanel Margin="0,4,0,0">
                  <TextBlock x:Name="StatBandwidth" Text="—" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource Display}" Foreground="#9FD8FF"/>
                  <TextBlock x:Name="LblStatBandwidth" Style="{StaticResource Mini}"/>
                </StackPanel>
                <StackPanel Margin="0,4,0,0">
                  <TextBlock x:Name="StatVersion" Text="—" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource Display}"/>
                  <TextBlock x:Name="LblStatVersion" Style="{StaticResource Mini}"/>
                </StackPanel>
              </UniformGrid>
              <TextBlock x:Name="TxtNetNote" FontSize="11.5" Foreground="{StaticResource Tertiary}" Margin="0,12,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </ContentControl>

          <TextBlock x:Name="HdrRelays" Style="{StaticResource Header}"/>
          <ContentControl Style="{StaticResource Card}" Padding="12">
            <StackPanel>
              <Grid>
                <TextBox x:Name="TxtRelaySearch" Style="{StaticResource Input}" Padding="17,4,5,4"/>
                <Viewbox Width="14" Height="14" HorizontalAlignment="Left" Margin="13,0,0,0" IsHitTestVisible="False">
                  <Canvas Width="24" Height="24">
                    <Path Style="{StaticResource Glyph}" Stroke="#99FFFFFF" StrokeThickness="2.5" Data="M10.5,3 A7.5,7.5 0 1 0 10.51,3 Z M16,16 L21,21"/>
                  </Canvas>
                </Viewbox>
                <TextBlock x:Name="PhRelaySearch" Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource Tertiary}"/>
              </Grid>
              <Grid Margin="0,10,0,0">
                <Border CornerRadius="11" Background="#2A000000" BorderBrush="#14FFFFFF" BorderThickness="1" Padding="1" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="SegRelAll" Style="{StaticResource Seg}" GroupName="relfilter" IsChecked="True"/>
                    <RadioButton x:Name="SegRelExit" Style="{StaticResource Seg}" GroupName="relfilter"/>
                    <RadioButton x:Name="SegRelGuard" Style="{StaticResource Seg}" GroupName="relfilter"/>
                  </StackPanel>
                </Border>
                <TextBlock x:Name="TxtRelayCount" FontSize="11.5" Foreground="{StaticResource Secondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
              <ListBox x:Name="RelayList" Height="290" Margin="0,10,0,0" Background="Transparent" BorderThickness="0"
                       ItemContainerStyle="{StaticResource CountryItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Border Width="26" Height="18" CornerRadius="4" Margin="0,0,10,0" Background="{Binding Flag}" BorderBrush="#26FFFFFF" BorderThickness="0.5" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" Foreground="#F5F5F7" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Detail}" Foreground="#90FFFFFF" FontSize="11" FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Bandwidth}" Foreground="#C0FFFFFF" FontSize="11.5" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding Badges}" Foreground="#9BF5B4" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <Border x:Name="RelayDetail" CornerRadius="16" Background="#16FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="14" Margin="0,10,0,0" Visibility="Collapsed">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="RelayFlag" Width="40" Height="28" CornerRadius="6" Margin="0,0,12,0" BorderBrush="#30FFFFFF" BorderThickness="0.5" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock x:Name="RelayNick" FontSize="17" FontWeight="SemiBold" FontFamily="{StaticResource Display}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock x:Name="RelayWhere" FontSize="12" Foreground="{StaticResource Secondary}"/>
                    </StackPanel>
                  </Grid>
                  <WrapPanel x:Name="RelayBadges" Margin="0,12,0,0"/>
                  <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock x:Name="LblRelayFp" Style="{StaticResource Mini}"/>
                      <TextBlock x:Name="RelayFp" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="#DDBFFF" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button x:Name="BtnCopyFp" Grid.Column="1" Style="{StaticResource IconBtn}" VerticalAlignment="Center">
                      <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24">
                        <Path Stroke="White" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M9,9 H18 A2,2 0 0 1 20,11 V19 A2,2 0 0 1 18,21 H11 A2,2 0 0 1 9,19 Z M15,9 V6 A2,2 0 0 0 13,4 H6 A2,2 0 0 0 4,6 V13 A2,2 0 0 0 6,15 H9"/>
                      </Canvas></Viewbox>
                    </Button>
                  </Grid>
                  <UniformGrid Columns="2" Margin="0,12,0,0">
                    <StackPanel Margin="0,0,8,10">
                      <TextBlock x:Name="LblRelayAddr" Style="{StaticResource Mini}"/>
                      <TextBlock x:Name="RelayAddr" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                      <TextBlock x:Name="LblRelayBw" Style="{StaticResource Mini}"/>
                      <TextBlock x:Name="RelayBw" FontSize="12.5" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                      <TextBlock x:Name="LblRelayV6" Style="{StaticResource Mini}"/>
                      <TextBlock x:Name="RelayV6" FontFamily="{StaticResource Mono}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel>
                      <TextBlock x:Name="LblRelayVersion" Style="{StaticResource Mini}"/>
                      <TextBlock x:Name="RelayVersion" FontSize="12.5" Margin="0,3,0,0"/>
                    </StackPanel>
                  </UniformGrid>
                </StackPanel>
              </Border>
            </StackPanel>
          </ContentControl>

          <TextBlock x:Name="HdrAbout" Style="{StaticResource Header}"/>
          <ContentControl Style="{StaticResource Card}" Padding="16,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <Image Source="{StaticResource Logo}" Width="52" Height="52" Margin="0,0,14,0" VerticalAlignment="Top"/>
              <StackPanel Grid.Column="1">
                <TextBlock x:Name="TxtAbout1" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource Display}"/>
                <TextBlock x:Name="TxtAbout2" FontSize="12" Foreground="{StaticResource Secondary}" Margin="0,2,0,0"/>
                <TextBlock x:Name="LnkNetcat" FontSize="12" Foreground="#C9A2F7" Cursor="Hand" Margin="0,2,0,0" Text="netcattest.com ↗"/>
                <TextBlock x:Name="TxtAbout3" FontSize="11" Foreground="{StaticResource Tertiary}" Margin="0,8,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
          </ContentControl>

          <Button x:Name="BtnQuitApp" Style="{StaticResource Pill}" Background="#33FF453A" Padding="16,11" Margin="0,22,0,0">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="14" Height="14" Margin="0,0,8,0"><Canvas Width="24" Height="24">
                <Path Style="{StaticResource Glyph}" Stroke="#FF9E96" StrokeThickness="2.4" Data="M15,4 H19 A1,1 0 0 1 20,5 V19 A1,1 0 0 1 19,20 H15 M10,8 L6,12 L10,16 M6,12 H16"/>
              </Canvas></Viewbox>
              <TextBlock x:Name="LblQuitApp" Foreground="#FFB4AD"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>

  <Grid x:Name="Splash">
    <Border>
      <Border.Background>
        <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.9" RadiusY="0.7">
          <GradientStop Color="#FF3A2160" Offset="0"/>
          <GradientStop Color="#FF17121F" Offset="0.55"/>
          <GradientStop Color="#FF0D0C12" Offset="1"/>
        </RadialGradientBrush>
      </Border.Background>
    </Border>
    <Ellipse x:Name="SplashGlow" Width="360" Height="360" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,60" Opacity="0">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#909B5DE5" Offset="0"/>
          <GradientStop Color="#009B5DE5" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,40">
      <Viewbox Width="124" Height="124">
        <Canvas Width="256" Height="256">
          <Path x:Name="SpTile" RenderTransformOrigin="0.5,0.5" Opacity="0"
                Data="M66,8 H190 A58,58 0 0 1 248,66 V190 A58,58 0 0 1 190,248 H66 A58,58 0 0 1 8,190 V66 A58,58 0 0 1 66,8 Z">
            <Path.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#C08CFF" Offset="0"/>
                <GradientStop Color="#7B45D6" Offset="0.5"/>
                <GradientStop Color="#2E1666" Offset="1"/>
              </LinearGradientBrush>
            </Path.Fill>
            <Path.RenderTransform><ScaleTransform x:Name="SpTileScale"/></Path.RenderTransform>
          </Path>
          <Path x:Name="SpGloss" Opacity="0"
                Data="M66,8 H190 A58,58 0 0 1 248,66 V190 A58,58 0 0 1 190,248 H66 A58,58 0 0 1 8,190 V66 A58,58 0 0 1 66,8 Z">
            <Path.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#6BFFFFFF" Offset="0"/>
                <GradientStop Color="#0FFFFFFF" Offset="0.45"/>
                <GradientStop Color="#00FFFFFF" Offset="1"/>
              </LinearGradientBrush>
            </Path.Fill>
          </Path>
          <Path x:Name="SpL1" Stroke="#8CFFFFFF" StrokeThickness="11" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                Data="M128,44 C147,78 198,98 198,150 A70,70 0 0 1 58,150 C58,98 109,78 128,44 Z"/>
          <Path x:Name="SpL2" Stroke="#D9FFFFFF" StrokeThickness="10" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                Data="M128,86 C141,107 170,121 170,153 A42,42 0 0 1 86,153 C86,121 115,107 128,86 Z"/>
          <Path x:Name="SpCore" Fill="White" RenderTransformOrigin="0.5,0.7"
                Data="M128,124 C134,134 148,142 148,157 A20,20 0 0 1 108,157 C108,142 122,134 128,124 Z">
            <Path.RenderTransform><ScaleTransform x:Name="SpCoreScale" ScaleX="0" ScaleY="0"/></Path.RenderTransform>
          </Path>
        </Canvas>
      </Viewbox>
      <TextBlock x:Name="SplashName" Text="Veil" FontSize="30" FontWeight="SemiBold" FontFamily="{StaticResource Display}"
                 HorizontalAlignment="Center" Margin="0,22,0,0" Opacity="0">
        <TextBlock.RenderTransform><TranslateTransform x:Name="SplashNameY" Y="10"/></TextBlock.RenderTransform>
      </TextBlock>
      <TextBlock x:Name="SplashBy" Text="NetCat Test" FontSize="11.5" Foreground="{StaticResource Tertiary}" HorizontalAlignment="Center" Margin="0,4,0,0" Opacity="0"/>
    </StackPanel>
  </Grid>
</Grid>
