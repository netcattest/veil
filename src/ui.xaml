<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      TextElement.Foreground="#F5F5F7"
      TextElement.FontFamily="Segoe UI Variable Text, Segoe UI"
      TextElement.FontSize="13"
      UseLayoutRounding="True">

  <Grid.Resources>
    <SolidColorBrush x:Key="Secondary" Color="#9AFFFFFF"/>
    <SolidColorBrush x:Key="Tertiary" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="Hairline" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="Accent" Color="#C9A2F7"/>
    <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>

    <DrawingImage x:Key="Logo">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Geometry="M66,8 H190 A58,58 0 0 1 248,66 V190 A58,58 0 0 1 190,248 H66 A58,58 0 0 1 8,190 V66 A58,58 0 0 1 66,8 Z">
            <GeometryDrawing.Brush>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#C08CFF" Offset="0"/>
                <GradientStop Color="#7B45D6" Offset="0.5"/>
                <GradientStop Color="#2E1666" Offset="1"/>
              </LinearGradientBrush>
            </GeometryDrawing.Brush>
          </GeometryDrawing>
          <GeometryDrawing Geometry="M66,8 H190 A58,58 0 0 1 248,66 V190 A58,58 0 0 1 190,248 H66 A58,58 0 0 1 8,190 V66 A58,58 0 0 1 66,8 Z">
            <GeometryDrawing.Brush>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#6BFFFFFF" Offset="0"/>
                <GradientStop Color="#0FFFFFFF" Offset="0.45"/>
                <GradientStop Color="#00FFFFFF" Offset="1"/>
              </LinearGradientBrush>
            </GeometryDrawing.Brush>
          </GeometryDrawing>
          <GeometryDrawing Geometry="M128,44 C147,78 198,98 198,150 A70,70 0 0 1 58,150 C58,98 109,78 128,44 Z">
            <GeometryDrawing.Pen><Pen Brush="#8CFFFFFF" Thickness="11" LineJoin="Round"/></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="M128,86 C141,107 170,121 170,153 A42,42 0 0 1 86,153 C86,121 115,107 128,86 Z">
            <GeometryDrawing.Pen><Pen Brush="#D9FFFFFF" Thickness="10" LineJoin="Round"/></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Brush="White" Geometry="M128,124 C134,134 148,142 148,157 A20,20 0 0 1 108,157 C108,142 122,134 128,124 Z"/>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>

    <Style x:Key="Card" TargetType="ContentControl">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContentControl">
            <Grid>
              <Border CornerRadius="22" Background="#38000000">
                <Border.CacheMode><BitmapCache/></Border.CacheMode>
                <Border.Effect>
                  <DropShadowEffect BlurRadius="30" ShadowDepth="10" Direction="270" Opacity="0.35" Color="#000000"/>
                </Border.Effect>
              </Border>
              <Border CornerRadius="22" BorderThickness="1">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#26FFFFFF" Offset="0"/>
                    <GradientStop Color="#0CFFFFFF" Offset="0.5"/>
                    <GradientStop Color="#16FFFFFF" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0.7,1">
                    <GradientStop Color="#8CFFFFFF" Offset="0"/>
                    <GradientStop Color="#1AFFFFFF" Offset="0.35"/>
                    <GradientStop Color="#08FFFFFF" Offset="0.7"/>
                    <GradientStop Color="#40FFFFFF" Offset="1"/>
                  </LinearGradientBrush>
                </Border.BorderBrush>
              </Border>
              <Border CornerRadius="21" Margin="1" IsHitTestVisible="False">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0.3,0" EndPoint="0.5,1">
                    <GradientStop Color="#14FFFFFF" Offset="0"/>
                    <GradientStop Color="#05FFFFFF" Offset="0.18"/>
                    <GradientStop Color="#00FFFFFF" Offset="0.4"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <ContentPresenter Margin="{TemplateBinding Padding}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Header" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Tertiary}"/>
      <Setter Property="Margin" Value="18,22,0,8"/>
    </Style>

    <Style x:Key="Mini" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Tertiary}"/>
    </Style>

    <Style x:Key="Sep" TargetType="Rectangle">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Fill" Value="{StaticResource Hairline}"/>
      <Setter Property="Margin" Value="58,0,16,0"/>
    </Style>

    <Style x:Key="Tile" TargetType="Border">
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Glyph" TargetType="Path">
      <Setter Property="Stroke" Value="White"/>
      <Setter Property="StrokeThickness" Value="2"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="t" CornerRadius="3" Width="5" Background="#38FFFFFF" HorizontalAlignment="Center" Margin="0,4"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Background" Value="#80FFFFFF"/>
                            <Setter TargetName="t" Property="Width" Value="7"/>
                          </Trigger>
                          <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="t" Property="Background" Value="#A0FFFFFF"/>
                            <Setter TargetName="t" Property="Width" Value="7"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Light" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Width="13" Height="13" Background="Transparent">
              <Ellipse Fill="{TemplateBinding Background}" Stroke="#33000000" StrokeThickness="0.6"/>
              <ContentPresenter x:Name="g" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="g" Property="Opacity" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#D8FFFFFF"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Width="32" Height="32" CornerRadius="16" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#1FFFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#33FFFFFF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Pill" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#9B5DE5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="r" RenderTransformOrigin="0.5,0.5">
              <Border CornerRadius="12" Background="{TemplateBinding Background}" BorderThickness="1">
                <Border.BorderBrush>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#66FFFFFF" Offset="0"/>
                    <GradientStop Color="#10FFFFFF" Offset="1"/>
                  </LinearGradientBrush>
                </Border.BorderBrush>
              </Border>
              <Border CornerRadius="11,11,4,4" Margin="1" Height="14" VerticalAlignment="Top">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#30FFFFFF" Offset="0"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="r" Property="Opacity" Value="0.88"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="r" Property="RenderTransform">
                  <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="r" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource Pill}">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Background" Value="#1FFFFFFF"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="Power" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="r" Width="150" Height="150" Background="Transparent" RenderTransformOrigin="0.5,0.5">
              <Ellipse Width="128" Height="128" Fill="{TemplateBinding Background}">
                <Ellipse.Effect><BlurEffect Radius="34"/></Ellipse.Effect>
              </Ellipse>
              <Ellipse Width="116" Height="116" StrokeThickness="1.3">
                <Ellipse.Fill>
                  <LinearGradientBrush StartPoint="0.2,0" EndPoint="0.8,1">
                    <GradientStop Color="#36FFFFFF" Offset="0"/>
                    <GradientStop Color="#0AFFFFFF" Offset="0.55"/>
                    <GradientStop Color="#1CFFFFFF" Offset="1"/>
                  </LinearGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Stroke>
                  <LinearGradientBrush StartPoint="0.2,0" EndPoint="0.8,1">
                    <GradientStop Color="#B0FFFFFF" Offset="0"/>
                    <GradientStop Color="#10FFFFFF" Offset="0.5"/>
                    <GradientStop Color="#50FFFFFF" Offset="1"/>
                  </LinearGradientBrush>
                </Ellipse.Stroke>
              </Ellipse>
              <Ellipse Width="84" Height="40" VerticalAlignment="Top" Margin="0,24,0,0" IsHitTestVisible="False">
                <Ellipse.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#40FFFFFF" Offset="0"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                  </LinearGradientBrush>
                </Ellipse.Fill>
              </Ellipse>
              <Viewbox Width="42" Height="42">
                <Canvas Width="24" Height="24">
                  <Path Data="M12,2.8 V11 M6.4,6.2 A8.2,8.2 0 1 0 17.6,6.2" Stroke="{TemplateBinding Foreground}"
                        StrokeThickness="2.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>
              </Viewbox>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="r" Property="RenderTransform">
                  <Setter.Value><ScaleTransform ScaleX="1.035" ScaleY="1.035"/></Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="r" Property="RenderTransform">
                  <Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Row" TargetType="RadioButton">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="#F5F5F7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bg" Background="Transparent" Margin="6,3" Padding="10,8" CornerRadius="14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter VerticalAlignment="Center"/>
                <Path x:Name="chk" Grid.Column="1" Data="M1,6.5 L5.5,11 L14,1.5" Stroke="#C9A2F7" StrokeThickness="2.2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      VerticalAlignment="Center" Margin="12,0,4,0" Visibility="Hidden"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#10FFFFFF"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="chk" Property="Visibility" Value="Visible"/>
                <Setter TargetName="bg" Property="Background" Value="#14FFFFFF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="RowBtn" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="#F5F5F7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" Background="Transparent" Margin="6" Padding="10,8" CornerRadius="14">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#12FFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#1CFFFFFF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="#B8FFFFFF"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Margin="2">
              <Border x:Name="b" CornerRadius="9" Background="Transparent"/>
              <ContentPresenter Margin="8,6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="#3DFFFFFF"/>
                <Setter TargetName="b" Property="Effect">
                  <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.35"/>
                  </Setter.Value>
                </Setter>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Tab" TargetType="RadioButton">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="#8CFFFFFF"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" CornerRadius="20" Padding="0,7,0,6" Margin="3" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#DDFFFFFF"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="#24FFFFFF"/>
                <Setter Property="Foreground" Value="#DDBFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="track" Width="46" Height="28" CornerRadius="14" Background="#33FFFFFF">
              <Ellipse x:Name="knob" Width="24" Height="24" Fill="White" HorizontalAlignment="Left" Margin="2,0">
                <Ellipse.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.3"/></Ellipse.Effect>
              </Ellipse>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="#30D158"/>
                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Input" TargetType="TextBox">
      <Setter Property="Foreground" Value="#F5F5F7"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="SelectionBrush" Value="#9B5DE5"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" CornerRadius="12" Background="#24000000" BorderBrush="#22FFFFFF" BorderThickness="1">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#B49BE0"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CountryItem" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="b" CornerRadius="10" Padding="10,7" Margin="2,1" Background="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#14FFFFFF"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="b" Property="Background" Value="#4D9B5DE5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>

  <Border x:Name="Tint" Background="#990B0B12"/>
  <Canvas x:Name="BlobLayer" IsHitTestVisible="False" ClipToBounds="True">
    <Canvas.RenderTransform><TranslateTransform x:Name="BlobShift"/></Canvas.RenderTransform>
    <Ellipse x:Name="Blob1" Width="520" Height="520" Canvas.Left="-200" Canvas.Top="-190">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop x:Name="Blob1Stop" Color="#A07D4698" Offset="0"/>
          <GradientStop Color="#007D4698" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>
    <Ellipse x:Name="Blob2" Width="460" Height="460" Canvas.Left="150" Canvas.Top="160">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#702D63E0" Offset="0"/>
          <GradientStop Color="#002D63E0" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>
    <Ellipse x:Name="Blob3" Width="480" Height="480" Canvas.Left="-150" Canvas.Top="470">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#60C2398F" Offset="0"/>
          <GradientStop Color="#00C2398F" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>
  </Canvas>

  <Grid x:Name="Main">
    <Grid.RowDefinitions>
      <RowDefinition Height="52"/>
      <RowDefinition/>
    </Grid.RowDefinitions>

    <Grid Margin="18,0,12,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
        <Button x:Name="BtnClose" Style="{StaticResource Light}" Background="#FF5F57">
          <Path Data="M0,0 L5,5 M5,0 L0,5" Stroke="#80000000" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Button>
        <Button x:Name="BtnMin" Style="{StaticResource Light}" Background="#FEBC2E">
          <Path Data="M0,0 L6,0" Stroke="#80000000" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Button>
        <Button Style="{StaticResource Light}" Background="#3AFFFFFF" IsEnabled="False"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Image Source="{StaticResource Logo}" Width="18" Height="18" Margin="0,0,8,0"/>
        <TextBlock Text="Veil" FontWeight="SemiBold" FontSize="14" Foreground="#E8FFFFFF" FontFamily="{StaticResource Display}"/>
      </StackPanel>
      <Button x:Name="BtnSettings" Style="{StaticResource IconBtn}" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Viewbox Width="18" Height="18">
          <Canvas Width="24" Height="24">
            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
