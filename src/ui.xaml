        <RadioButton x:Name="TabBridges" Style="{StaticResource Tab}" GroupName="tabs">
          <StackPanel>
            <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24">
              <Path Style="{StaticResource Glyph}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="M2,17 H22 M4,17 V12 M20,17 V12 M3,12 C7,5 17,5 21,12 M8.5,17 V9.2 M15.5,17 V9.2 M12,17 V7.8"/>
            </Canvas></Viewbox>
