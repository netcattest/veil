              <Path Style="{StaticResource Glyph}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="M2.8,5 a2.2,2.2 0 1 0 4.4,0 a2.2,2.2 0 1 0 -4.4,0 M9.8,12 a2.2,2.2 0 1 0 4.4,0 a2.2,2.2 0 1 0 -4.4,0 M16.8,19 a2.2,2.2 0 1 0 4.4,0 a2.2,2.2 0 1 0 -4.4,0 M6.6,6.6 L10.4,10.4 M13.6,13.6 L17.4,17.4"/>
