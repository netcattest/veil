<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      TextElement.Foreground="#F5F5F7"
      TextElement.FontFamily="Segoe UI Variable Text, Segoe UI"
      TextElement.FontSize="13"
      UseLayoutRounding="True" Margin="16" Width="270" RenderTransformOrigin="1,1">
  <Grid.RenderTransform><ScaleTransform x:Name="MenuScale"/></Grid.RenderTransform>
  <Grid.Resources>
    <Style x:Key="Item" TargetType="Button">
      <Setter Property="Foreground" Value="#F5F5F7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="10" Padding="10,8" Margin="6,1" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#3D9B5DE5"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#5C9B5DE5"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Glyph" TargetType="Path">
      <Setter Property="Stroke" Value="#D8FFFFFF"/>
      <Setter Property="StrokeThickness" Value="2"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
    </Style>
  </Grid.Resources>

  <Border CornerRadius="18" Background="#40000000">
    <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.55"/></Border.Effect>
  </Border>
  <Border CornerRadius="18" BorderThickness="1">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F62A2434" Offset="0"/>
        <GradientStop Color="#F619181F" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Border.BorderBrush>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0.7,1">
        <GradientStop Color="#70FFFFFF" Offset="0"/>
        <GradientStop Color="#12FFFFFF" Offset="0.5"/>
        <GradientStop Color="#30FFFFFF" Offset="1"/>
      </LinearGradientBrush>
    </Border.BorderBrush>
  </Border>

  <StackPanel Margin="0,8,0,8">
    <Grid Margin="16,8,16,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <Image x:Name="Logo" Width="38" Height="38" Margin="0,0,12,0"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="Veil" FontSize="15" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"/>
        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
          <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="Status" FontSize="12" Foreground="#B0FFFFFF"/>
        </StackPanel>
      </StackPanel>
    </Grid>

    <Border x:Name="InfoBox" CornerRadius="12" Background="#14FFFFFF" Margin="12,0,12,8" Padding="12,10">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <Border x:Name="Flag" Width="22" Height="15" CornerRadius="3" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="Exit" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
        </StackPanel>
        <TextBlock x:Name="ExitIp" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="#99FFFFFF" Margin="0,4,0,0"/>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <TextBlock Text="↓ " Foreground="#C9A2F7" FontWeight="Bold"/>
          <TextBlock x:Name="Down" FontSize="12" Margin="0,0,14,0"/>
          <TextBlock Text="↑ " Foreground="#7EE2A0" FontWeight="Bold"/>
          <TextBlock x:Name="Up" FontSize="12"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Button x:Name="BtnOpen" Style="{StaticResource Item}">
      <StackPanel Orientation="Horizontal">
        <Viewbox Width="15" Height="15" Margin="0,0,10,0"><Canvas Width="24" Height="24">
          <Path Style="{StaticResource Glyph}" Data="M4,5 H20 A1,1 0 0 1 21,6 V18 A1,1 0 0 1 20,19 H4 A1,1 0 0 1 3,18 V6 A1,1 0 0 1 4,5 Z M3,9 H21"/>
        </Canvas></Viewbox>
        <TextBlock x:Name="LblOpen"/>
      </StackPanel>
    </Button>
    <Button x:Name="BtnToggle" Style="{StaticResource Item}">
      <StackPanel Orientation="Horizontal">
        <Viewbox Width="15" Height="15" Margin="0,0,10,0"><Canvas Width="24" Height="24">
          <Path Style="{StaticResource Glyph}" Data="M12,3 V11 M6.4,6.2 A8.2,8.2 0 1 0 17.6,6.2"/>
        </Canvas></Viewbox>
        <TextBlock x:Name="LblToggle"/>
      </StackPanel>
    </Button>
    <Button x:Name="BtnNew" Style="{StaticResource Item}">
      <StackPanel Orientation="Horizontal">
        <Viewbox Width="15" Height="15" Margin="0,0,10,0"><Canvas Width="24" Height="24">
          <Path Style="{StaticResource Glyph}" Data="M20,12 A8,8 0 1 1 17.7,6.3 M20,3.5 V8 H15.5"/>
        </Canvas></Viewbox>
        <TextBlock x:Name="LblNew"/>
      </StackPanel>
    </Button>
    <Rectangle Height="1" Fill="#17FFFFFF" Margin="16,6"/>
    <Button x:Name="BtnQuit" Style="{StaticResource Item}">
      <StackPanel Orientation="Horizontal">
        <Viewbox Width="15" Height="15" Margin="0,0,10,0"><Canvas Width="24" Height="24">
          <Path Style="{StaticResource Glyph}" Stroke="#FF8A80" Data="M15,4 H19 A1,1 0 0 1 20,5 V19 A1,1 0 0 1 19,20 H15 M10,8 L6,12 L10,16 M6,12 H16"/>
        </Canvas></Viewbox>
        <TextBlock x:Name="LblQuit" Foreground="#FF9E96"/>
      </StackPanel>
    </Button>
  </StackPanel>
</Grid>
