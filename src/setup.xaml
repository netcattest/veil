<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      TextElement.Foreground="#F5F5F7"
      TextElement.FontFamily="Segoe UI Variable Text, Segoe UI"
      TextElement.FontSize="13"
      UseLayoutRounding="True" Margin="18" Width="420">
  <Grid.Resources>
    <Style x:Key="Pill" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#9B5DE5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="18,11"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="r" RenderTransformOrigin="0.5,0.5">
              <Border CornerRadius="14" Background="{TemplateBinding Background}" BorderThickness="1">
                <Border.BorderBrush>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#66FFFFFF" Offset="0"/>
                    <GradientStop Color="#10FFFFFF" Offset="1"/>
                  </LinearGradientBrush>
                </Border.BorderBrush>
              </Border>
              <Border CornerRadius="13,13,4,4" Margin="1" Height="16" VerticalAlignment="Top">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#30FFFFFF" Offset="0"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="r" Property="Opacity" Value="0.88"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="r" Property="RenderTransform">
                  <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="r" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="track" Width="46" Height="28" CornerRadius="14" Background="#33FFFFFF">
              <Ellipse x:Name="knob" Width="24" Height="24" Fill="White" HorizontalAlignment="Left" Margin="2,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="#30D158"/>
                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Close" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Width="13" Height="13" Background="Transparent">
              <Ellipse Fill="#FF5F57" Stroke="#33000000" StrokeThickness="0.6"/>
              <Path x:Name="g" Data="M0,0 L5,5 M5,0 L0,5" Stroke="#80000000" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="g" Property="Opacity" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>

  <Border CornerRadius="26" Background="#40000000">
    <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="8" Direction="270" Opacity="0.5"/></Border.Effect>
  </Border>
  <Border CornerRadius="26" BorderThickness="1" ClipToBounds="True">
    <Border.Background>
      <RadialGradientBrush Center="0.3,0.1" GradientOrigin="0.3,0.1" RadiusX="1.1" RadiusY="0.9">
        <GradientStop Color="#FF3B2366" Offset="0"/>
        <GradientStop Color="#FF1C1828" Offset="0.55"/>
        <GradientStop Color="#FF111016" Offset="1"/>
      </RadialGradientBrush>
    </Border.Background>
    <Border.BorderBrush>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0.7,1">
        <GradientStop Color="#70FFFFFF" Offset="0"/>
        <GradientStop Color="#10FFFFFF" Offset="0.5"/>
        <GradientStop Color="#30FFFFFF" Offset="1"/>
      </LinearGradientBrush>
    </Border.BorderBrush>
  </Border>

  <Grid Margin="22,18,22,24">
    <Button x:Name="BtnClose" Style="{StaticResource Close}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
    <StackPanel Margin="0,14,0,0">
      <Image x:Name="Logo" Width="84" Height="84" HorizontalAlignment="Center">
        <Image.RenderTransform><ScaleTransform x:Name="LogoScale" CenterX="42" CenterY="42"/></Image.RenderTransform>
      </Image>
      <TextBlock Text="Veil" FontSize="30" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI" HorizontalAlignment="Center" Margin="0,14,0,0"/>
      <TextBlock x:Name="TxtVersion" FontSize="12" Foreground="#99FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
      <TextBlock x:Name="TxtIntro" FontSize="13" Foreground="#C8FFFFFF" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="10,16,10,0"/>

      <Border x:Name="Options" CornerRadius="16" Background="#14FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" Padding="14,12" Margin="0,20,0,0">
        <StackPanel>
          <Grid>
            <TextBlock x:Name="LblOption1" VerticalAlignment="Center"/>
            <CheckBox x:Name="Chk1" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True"/>
          </Grid>
          <Rectangle x:Name="OptionSep" Height="1" Fill="#17FFFFFF" Margin="0,10"/>
          <Grid x:Name="Option2">
            <TextBlock x:Name="LblOption2" VerticalAlignment="Center"/>
            <CheckBox x:Name="Chk2" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True"/>
          </Grid>
        </StackPanel>
      </Border>

      <Grid Margin="0,18,0,0" Height="8">
        <Border x:Name="Track" CornerRadius="4" Background="#1EFFFFFF" Opacity="0"/>
        <Border x:Name="Fill" CornerRadius="4" HorizontalAlignment="Left" Width="0">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#9B5DE5" Offset="0"/>
              <GradientStop Color="#D7A6FF" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
        </Border>
      </Grid>
      <TextBlock x:Name="TxtStatus" FontSize="12" Foreground="#99FFFFFF" HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center"/>

      <Button x:Name="BtnMain" Style="{StaticResource Pill}" Margin="0,14,0,0">
        <TextBlock x:Name="LblMain"/>
      </Button>
      <TextBlock x:Name="TxtPath" FontSize="11" Foreground="#66FFFFFF" HorizontalAlignment="Center" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" FontFamily="Cascadia Mono, Consolas"/>
    </StackPanel>
  </Grid>
</Grid>
